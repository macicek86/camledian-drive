--- /dev/null
+++ b/backend/webdav/write_guard.go
@@ -0,0 +1,100 @@
+package webdav
+
+import (
+	"context"
+	"encoding/xml"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/rclone/rclone/lib/rest"
+)
+
+type writeGuardResult struct {
+	allowed bool
+	expires time.Time
+}
+
+type writeGuardResponse struct {
+	XMLName   xml.Name `xml:"DAV: multistatus"`
+	Responses []struct {
+		Href  string `xml:"DAV: href"`
+		Props []struct {
+			Status string `xml:"DAV: status"`
+			Prop   struct {
+				ReadOnly     *string `xml:"DAV: isreadonly"`
+				ResourceType struct {
+					Collection *struct{} `xml:"DAV: collection"`
+				} `xml:"DAV: resourcetype"`
+			} `xml:"DAV: prop"`
+		} `xml:"DAV: propstat"`
+	} `xml:"DAV: response"`
+}
+
+// CheckVFSWrite is enabled only by the Camledian build/launcher. No uploaded
+// probe or hardcoded business paths: the authenticated server advertises rights.
+func (f *Fs) CheckVFSWrite(ctx context.Context, directory string) error {
+	if !f.opt.VFSWriteGuard {
+		return nil
+	}
+	f.writeGuardMu.Lock()
+	cached, found := f.writeGuard[directory]
+	f.writeGuardMu.Unlock()
+	if found && time.Now().Before(cached.expires) {
+		if cached.allowed {
+			return nil
+		}
+		return os.ErrPermission
+	}
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	opts := rest.Opts{
+		Method:        "PROPFIND",
+		Path:          f.dirPath(directory),
+		Body:          strings.NewReader(`<d:propfind xmlns:d="DAV:"><d:prop><d:resourcetype/><d:isreadonly/></d:prop></d:propfind>`),
+		ContentType:   "application/xml; charset=utf-8",
+		ExtraHeaders:  map[string]string{"Depth": "0"},
+		CheckRedirect: rest.PreserveMethodRedirectFn,
+	}
+	var result writeGuardResponse
+	resp, err := f.srv.CallXML(ctx, &opts, nil, &result)
+	if err != nil || resp.StatusCode != http.StatusMultiStatus {
+		// No stale permissions on network failure, no inferred writable default.
+		return os.ErrPermission
+	}
+	wanted, err := url.Parse(f.endpointURL + f.dirPath(directory))
+	if err != nil {
+		return os.ErrPermission
+	}
+	allowed := false
+	for _, response := range result.Responses {
+		href, err := url.Parse(response.Href)
+		if err != nil {
+			continue
+		}
+		resolved := wanted.ResolveReference(href)
+		if resolved.Scheme != wanted.Scheme || resolved.Host != wanted.Host ||
+			strings.TrimRight(resolved.Path, "/") != strings.TrimRight(wanted.Path, "/") {
+			continue
+		}
+		for _, prop := range response.Props {
+			status := strings.Fields(prop.Status)
+			if len(status) < 2 || status[1] != "200" || prop.Prop.ResourceType.Collection == nil || prop.Prop.ReadOnly == nil {
+				continue
+			}
+			allowed = strings.TrimSpace(*prop.Prop.ReadOnly) == "0"
+		}
+	}
+	f.writeGuardMu.Lock()
+	if len(f.writeGuard) >= 512 || f.writeGuard == nil {
+		f.writeGuard = make(map[string]writeGuardResult)
+	}
+	f.writeGuard[directory] = writeGuardResult{allowed, time.Now().Add(5 * time.Second)}
+	f.writeGuardMu.Unlock()
+	if !allowed {
+		return os.ErrPermission
+	}
+	return nil
+}
