<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CamledianDrive</AssemblyName>
    <RootNamespace>CamledianDrive</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ikona-tray.ico</ApplicationIcon>
    <!-- DPI awareness is declared in app.manifest, which is correct for this
         WPF app; the WinForms analyzer doesn't recognize that and suggests an
         API that only applies to pure WinForms apps. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ikona-tray.png" />
  </ItemGroup>
</Project>
