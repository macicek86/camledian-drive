@@ -0,0 +1,79 @@
+package webdav
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/rclone/rclone/lib/rest"
+)
+
+func TestVFSWriteGuard(t *testing.T) {
+	for _, tc := range []struct {
+		name, prop, status, href string
+		want                     bool
+	}{
+		{"writable", "<d:isreadonly>0</d:isreadonly>", "200 OK", "/webdav/Intern%C3%AD/", true},
+		{"readonly", "<d:isreadonly>1</d:isreadonly>", "200 OK", "/webdav/Intern%C3%AD/", false},
+		{"missing", "", "200 OK", "/webdav/Intern%C3%AD/", false},
+		{"unknown", "<d:isreadonly>false</d:isreadonly>", "200 OK", "/webdav/Intern%C3%AD/", false},
+		{"wrong-status", "<d:isreadonly>0</d:isreadonly>", "403 Forbidden", "/webdav/Intern%C3%AD/", false},
+		{"wrong-path", "<d:isreadonly>0</d:isreadonly>", "200 OK", "/webdav/other/", false},
+		{"wrong-host", "<d:isreadonly>0</d:isreadonly>", "200 OK", "https://example.test/webdav/Intern%C3%AD/", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			calls := 0
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				calls++
+				user, pass, _ := r.BasicAuth()
+				if r.Method != "PROPFIND" || r.Header.Get("Depth") != "0" || user != "user" || pass != "secret" {
+					t.Error("unauthenticated or incorrect preflight")
+				}
+				w.Header().Set("Content-Type", "application/xml")
+				w.WriteHeader(207)
+				fmt.Fprintf(w, `<d:multistatus xmlns:d="DAV:"><d:response><d:href>%s</d:href><d:propstat><d:prop><d:resourcetype><d:collection/></d:resourcetype>%s</d:prop><d:status>HTTP/1.1 %s</d:status></d:propstat></d:response></d:multistatus>`, tc.href, tc.prop, tc.status)
+			}))
+			defer server.Close()
+			f := &Fs{opt: Options{VFSWriteGuard: true}, endpointURL: server.URL + "/webdav/",
+				srv: rest.NewClient(server.Client()).SetRoot(server.URL+"/webdav/").SetUserPass("user", "secret")}
+			for range 2 {
+				if allowed := f.CheckVFSWrite(context.Background(), "Interní") == nil; allowed != tc.want {
+					t.Errorf("allowed=%v, want %v", allowed, tc.want)
+				}
+			}
+			if calls != 1 {
+				t.Errorf("short permission cache failed: calls=%d", calls)
+			}
+			f.writeGuard["Interní"] = writeGuardResult{tc.want, time.Now().Add(-time.Second)}
+			server.Close()
+			if f.CheckVFSWrite(context.Background(), "Interní") == nil {
+				t.Error("stale permission on network failure")
+			}
+		})
+	}
+}
+
+func TestVFSWriteGuardDisabled(t *testing.T) {
+	f := &Fs{}
+	if f.CheckVFSWrite(context.Background(), "anything") != nil {
+		t.Fatal("ordinary rclone changed")
+	}
+}
+
+func TestVFSWriteGuardBadResponses(t *testing.T) {
+	for _, body := range []string{"invalid xml", `<d:multistatus xmlns:d="DAV:"/>`, `<x/>`} {
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(207)
+			fmt.Fprint(w, body)
+		}))
+		f := &Fs{opt: Options{VFSWriteGuard: true}, endpointURL: server.URL + "/", srv: rest.NewClient(server.Client()).SetRoot(server.URL + "/")}
+		if f.CheckVFSWrite(context.Background(), strings.TrimSpace("dir")) == nil {
+			t.Error("malformed response accepted")
+		}
+		server.Close()
+	}
+}
