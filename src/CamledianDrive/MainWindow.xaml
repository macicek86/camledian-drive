<Window x:Class="CamledianDrive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camledian Drive"
        Height="560"
        Width="430"
        MinHeight="520"
        MinWidth="400"
        WindowStartupLocation="CenterScreen"
        Background="#071F32">
    <Window.Resources>
        <SolidColorBrush x:Key="GoldBrush" Color="#F3C85B" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0D2B43" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center">
            <Border Width="118" Height="118" CornerRadius="20" Background="#061827" Padding="8">
                <Image Source="Assets/camledian-drive-icon.png" Stretch="Uniform" />
            </Border>
            <TextBlock Text="Camledian Drive"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource GoldBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0" />
            <TextBlock Text="Soubory z Camledian Commanderu přímo v Průzkumníku"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"
                       Opacity="0.75" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                CornerRadius="14"
                Padding="22"
                Margin="0,24,0,20"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Uživatelské jméno" Margin="0,0,0,6" />
                <TextBox x:Name="UsernameBox" Margin="0,0,0,14" />

                <TextBlock Text="Heslo" Margin="0,0,0,6" />
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,18" />

                <Button x:Name="ConnectButton"
                        Content="Připojit Camledian Drive"
                        Height="44"
                        FontWeight="SemiBold"
                        Click="ConnectButton_Click" />

                <Button x:Name="DisconnectButton"
                        Content="Odpojit"
                        Height="38"
                        Margin="0,10,0,0"
                        IsEnabled="False"
                        Click="DisconnectButton_Click" />

                <TextBlock x:Name="StatusText"
                           Text="Nepřipojeno"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{StaticResource GoldBrush}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center">
            <TextBlock Text="Camledian Drive (X:)"
                       HorizontalAlignment="Center"
                       FontSize="11"
                       Opacity="0.65" />
            <TextBlock Text="Bezpečné spojení přes HTTPS"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"
                       FontSize="10"
                       Opacity="0.45" />
        </StackPanel>
    </Grid>
</Window>
