<Window x:Class="CamledianDrive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camledian Drive"
        Icon="Assets/camledian-drive.ico"
        Height="735"
        Width="470"
        MinHeight="620"
        MinWidth="410"
        WindowStartupLocation="CenterScreen"
        Background="#071F32">
    <Window.Resources>
        <SolidColorBrush x:Key="GoldBrush" Color="#F3C85B" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0D2B43" />
        <SolidColorBrush x:Key="MutedBrush" Color="#B9C6D0" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="{StaticResource GoldBrush}" />
            <Setter Property="Foreground" Value="#071F32" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="#173C58" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#355E7A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <Border Width="108" Height="108" CornerRadius="20" Background="#061827" Padding="8">
                    <Image Source="Assets/camledian-drive-icon.png" Stretch="Uniform" />
                </Border>
                <TextBlock Text="Camledian Drive"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource GoldBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
                <TextBlock Text="Soubory z Camledian Commanderu přímo v Průzkumníku"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14"
                    Padding="22"
                    Margin="0,22,0,18">
                <StackPanel>
                    <TextBlock Text="Uživatelské jméno" Margin="0,0,0,6" />
                    <TextBox x:Name="UsernameBox" Margin="0,0,0,14" />

                    <TextBlock Text="Heslo" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PasswordBox" Margin="0,0,0,12" />

                    <CheckBox x:Name="RememberCredentialsCheckBox"
                              Content="Zapamatovat přihlášení v systému Windows"
                              IsChecked="True"
                              Foreground="{StaticResource MutedBrush}"
                              Margin="0,0,0,18"
                              Unchecked="RememberCredentialsCheckBox_Unchecked" />

                    <Button x:Name="ConnectButton"
                            Content="Připojit Camledian Drive"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="ConnectButton_Click" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="OpenDriveButton"
                                Grid.Column="0"
                                Content="Otevřít disk"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="False"
                                Click="OpenDriveButton_Click" />

                        <Button x:Name="DisconnectButton"
                                Grid.Column="2"
                                Content="Odpojit"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="False"
                                Click="DisconnectButton_Click" />
                    </Grid>

                    <Border Margin="0,16,0,0"
                            Padding="10"
                            CornerRadius="8"
                            Background="#082238">
                        <TextBlock x:Name="StatusText"
                                   Text="Zjišťuji stav…"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource GoldBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                <TextBlock Text="Camledian Drive (X:)"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="Bezpečné spojení přes HTTPS"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           FontSize="10"
                           Foreground="{StaticResource MutedBrush}"
                           Opacity="0.7" />
                <TextBlock Text="Zavřením okna zůstane aplikace spuštěná v oznamovací oblasti."
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           FontSize="10"
                           Foreground="{StaticResource MutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Opacity="0.65" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
