diff --git a/vfs/write_guard.go b/vfs/write_guard.go
new file mode 100644
index 0000000..ca676e0
--- /dev/null
+++ b/vfs/write_guard.go
@@ -0,0 +1,18 @@
+package vfs
+
+import "context"
+
+// Optional backend preflight, before a write changes local VFS/cache state.
+// Remote enforcement remains authoritative; later failures still use writeback.
+type writeAccessChecker interface {
+	CheckVFSWrite(context.Context, string) error
+}
+
+func (vfs *VFS) checkWriteAccess(directory string) error {
+	if checker, ok := vfs.f.(writeAccessChecker); ok {
+		if err := checker.CheckVFSWrite(vfs.ctx, directory); err != nil {
+			return EPERM
+		}
+	}
+	return nil
+}
