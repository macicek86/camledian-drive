<Window x:Class="CamledianDrive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camledian Drive"
        Height="500"
        Width="430"
        MinHeight="470"
        MinWidth="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Camledian Drive" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Přístup k souborům Camledian Commander"
                       Margin="0,6,0,0"
                       Opacity="0.7" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Uživatelské jméno" Margin="0,0,0,6" />
            <TextBox x:Name="UsernameBox" Height="36" Margin="0,0,0,14" />

            <TextBlock Text="Heslo" Margin="0,0,0,6" />
            <PasswordBox x:Name="PasswordBox" Height="36" Margin="0,0,0,18" />

            <Button x:Name="ConnectButton"
                    Content="Připojit Camledian Drive"
                    Height="42"
                    Click="ConnectButton_Click" />

            <Button x:Name="DisconnectButton"
                    Content="Odpojit"
                    Height="36"
                    Margin="0,10,0,0"
                    IsEnabled="False"
                    Click="DisconnectButton_Click" />

            <TextBlock x:Name="StatusText"
                       Text="Nepřipojeno"
                       Margin="0,18,0,0"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center">
            <TextBlock Text="Disk X: • https://admin.camledian.art/webdav/"
                       HorizontalAlignment="Center"
                       FontSize="11"
                       Opacity="0.5" />
            <TextBlock Text="Vyžaduje rclone a WinFsp"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"
                       FontSize="10"
                       Opacity="0.45" />
        </StackPanel>
    </Grid>
</Window>
