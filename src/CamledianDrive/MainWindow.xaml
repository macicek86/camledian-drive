<Window x:Class="CamledianDrive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camledian Drive"
        Height="480"
        Width="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Camledian Drive" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Bezpečný přístup k souborům Camledian" Margin="0,6,0,0" Opacity="0.7" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Uživatelské jméno" Margin="0,0,0,6" />
            <TextBox x:Name="UsernameBox" Height="36" Margin="0,0,0,14" />

            <TextBlock Text="Heslo" Margin="0,0,0,6" />
            <PasswordBox x:Name="PasswordBox" Height="36" Margin="0,0,0,18" />

            <Button x:Name="ConnectButton"
                    Content="Připojit Camledian Drive"
                    Height="42"
                    Click="ConnectButton_Click" />

            <TextBlock x:Name="StatusText"
                       Text="Nepřipojeno"
                       Margin="0,18,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="https://admin.camledian.art/webdav/"
                   HorizontalAlignment="Center"
                   FontSize="11"
                   Opacity="0.5" />
    </Grid>
</Window>
